<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}{% if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap">

    {{ content_for_header }}
    {{ 'application.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-ink: {{ settings.color_ink | default: '#0B0B0F' }};
        --color-cream: {{ settings.color_cream | default: '#FAF7F2' }};
        --color-rose: {{ settings.color_accent | default: '#E0577A' }};
        --color-rose-100: #FFE4EA;
        --color-rose-600: #C53D63;
      }
    </style>

    <script>document.documentElement.classList.replace('no-js','js');</script>
  </head>

  <body class="template-{{ template | replace: '.', '-' | handle }}">
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    {% sections 'announcement-group' %}
    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <script src="{{ 'application.js' | asset_url }}" defer></script>
  </body>
</html>
