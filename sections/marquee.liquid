<div class="marquee">
  <div class="marquee-track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>✦ {{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Gratis Versand CH" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "Gratis Versand CH" } },
      { "type": "item", "settings": { "text": "30 Tage Rückgabe" } },
      { "type": "item", "settings": { "text": "Dermatologisch empfohlen" } },
      { "type": "item", "settings": { "text": "Hergestellt in der Schweiz" } },
      { "type": "item", "settings": { "text": "1’000+ Reviews" } }
    ]
  },
  "presets": [
    { "name": "Marquee" }
  ]
}
{% endschema %}
