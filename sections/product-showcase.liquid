{%- assign product = section.settings.product -%}
<section class="showcase section">
  <div class="container grid grid-2">
    <div class="hero-image" style="aspect-ratio:1/1;">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ product.title | default: section.settings.fallback_title | escape }}">
      {%- elsif product != blank and product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.title | escape }}">
      {%- else -%}
        <div style="display:flex; align-items:center; justify-content:center; height:100%; background: var(--color-rose-100); color: var(--color-rose-600); font-family: 'Fraunces', serif; font-size: 6rem;">✦</div>
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="badge">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 style="margin-top:1rem;">{{ product.title | default: section.settings.fallback_title }}</h2>
      <p style="font-size:1.125rem; color: rgba(250,247,242,.75); max-width: 28rem; margin-top:1rem;">
        {{ section.settings.description }}
      </p>
      {%- if section.blocks.size > 0 -%}
        <ul style="margin-top:1.5rem;">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if product != blank -%}
        <div class="price" style="margin-top:1.5rem;">
          <span class="price-amount">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="price-compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="hero-cta">
        <a href="{% if product != blank %}{{ product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="btn btn-light">{{ section.settings.button_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkt Showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Bestseller" },
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "text", "id": "fallback_title", "label": "Fallback-Titel", "default": "Renuvia SilkTouch™" },
    { "type": "textarea", "id": "description", "label": "Beschreibung", "default": "Verwandle deine Dusche in eine Spa-Routine. Sanft wirksames Peeling, hygienisch dank Silberionen, in 15 Minuten trocken." },
    { "type": "image_picker", "id": "image", "label": "Bild (überschreibt Produktbild)" },
    { "type": "text", "id": "button_label", "label": "Button Text", "default": "Zum Produkt" }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Mit antibakteriellen Silberionen" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "highlight", "settings": { "text": "Mit antibakteriellen Silberionen" } },
      { "type": "highlight", "settings": { "text": "Quick-Dry Technologie" } },
      { "type": "highlight", "settings": { "text": "Ergonomisch verlängert" } },
      { "type": "highlight", "settings": { "text": "Dermatologisch empfohlen" } }
    ]
  },
  "presets": [
    { "name": "Produkt Showcase" }
  ]
}
{% endschema %}
